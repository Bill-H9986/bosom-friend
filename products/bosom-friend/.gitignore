# 产品层忽略：桌面壳运行时与构建产物不入库
desktop/dist/
desktop/vendor-kernel*/
desktop/release/

# QA 证据（截图/日志/验收录屏）是运行产物，不是源码；导入脚本同样按 evidence/acceptance 排除
qa/evidence/
qa/acceptance/
# 旧 harness 源码留档，不参与构建也不进 git
legacy-archive/

# QA 现场调试残留：一次性探针、临时截图与运行目录，新增即拦
# （存量里已被 git 跟踪的 __* 文件不在此列，另行清理）
qa/probes/__*
qa/reports/__*
qa/reports/lv-*-run/
launcher/scripts/__probe*
# 安装器的编译产物（源码在 installer/，随包发布走 desktop/release/）
installer/*.exe
