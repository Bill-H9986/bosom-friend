# 本机到 npm registry 的链路不稳定：大 tarball（claude-agent-sdk / codex 这类几十 MB 的
# 平台包）默认超时会在下载中途被 abort。放宽超时与重试，安装才能跑完。
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
network-concurrency=8

# pnpm deploy 要求：从工作区部署时必须注入 workspace 依赖（用于内核运行时物化）
inject-workspace-packages=true
